{
  "name": "imageway-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter svelte-imageway build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run check:svelte && bun run build && bun run test:coverage",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "fixtures": "bun scripts/generate-fixtures.ts",
    "test:e2e": "playwright test",
    "build:components": "bun run --filter @imageway/example-components build && bun run --filter @imageway/example-components build:ssr && bun scripts/render-example.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "blurhash": "2.0.5",
    "eslint": "9.39.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "ipaddr.js": "^2.2.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "sharp": "0.35.5",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "svgo": "4.1.0",
    "thumbhash": "0.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
